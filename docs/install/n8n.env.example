# n8n instance environment (read by n8n.service)
# Secret values live ONLY here; file must be chmod 600.

# Loopback-only binding (US-05.1)
N8N_LISTEN_ADDRESS=127.0.0.1
N8N_PORT=5678

# Instance identity (loopback)
N8N_HOST=127.0.0.1
N8N_PROTOCOL=http
WEBHOOK_URL=http://127.0.0.1:5678/

# n8n public API key (generated in the n8n UI: Settings -> n8n API)
N8N_API_KEY=
