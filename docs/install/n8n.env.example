# n8n instance environment (read by n8n.service)
# Secret values live ONLY here; file must be chmod 600.
#
# N8N_ENCRYPTION_KEY: intentionally NOT set here. n8n auto-generates the
# key on first start and stores it in ~/.n8n/config — no action needed.
# Credentials (and the webhook/API secrets) are encrypted with that key,
# so backing up ~/.n8n (config + SQLite database) is what protects them:
# losing the directory without a backup loses access to stored
# credentials. If you ever set N8N_ENCRYPTION_KEY explicitly, keep it
# out of version control and back it up with ~/.n8n.

# Loopback-only binding (US-05.1)
N8N_LISTEN_ADDRESS=127.0.0.1
N8N_PORT=5678

# Instance identity (loopback)
N8N_HOST=127.0.0.1
N8N_PROTOCOL=http
WEBHOOK_URL=http://127.0.0.1:5678/

# n8n public API key (generated in the n8n UI: Settings -> n8n API)
N8N_API_KEY=
